    },
    {
      "title":"جمع",
      "rule":"پسوند پیشنهادی جمع: ان",
      "example":"دوست ← دوستان"
    },
    {
      "title":"مالکیت",
      "rule":"پسوند پیشنهادی مالکیت: ی",
      "example":"خانه ← خانه‌ی من"
    },
    {
      "title":"صفت",
      "rule":"صفت پس از اسم قرار می‌گیرد",
      "example":"خانه بزرگ"
    },
    {
      "title":"جهت نوشتار",
      "rule":"چپ به راست",
      "example":"PARSIC"
    }
  ]
